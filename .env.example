# ── Basecamp environment ──────────────────────────────────────────────────────
# Copy to ".env.local" for local dev, and set the same vars in Vercel.

# Which backend to use for mutable user state.
#   local    → browser localStorage (default; no setup, single device)
#   supabase → Postgres + Google auth, syncs across devices
VITE_DATA_BACKEND=local

# Required ONLY when VITE_DATA_BACKEND=supabase.
# Find these in Supabase → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Google Health API integration (optional; pulls Fitbit data) ───────────────
# The legacy Fitbit Web API is retired (Sept 2026); data now comes via the
# Google Health API using Google OAuth 2.0. Set up at https://developers.google.com/health/setup:
#   1. Create a Google Cloud project; enable the "Google Health API".
#   2. OAuth consent screen: External + Testing; add yourself under Test users.
#   3. Data Access: add the 4 googlehealth.*.readonly scopes (activity_and_fitness,
#      sleep, health_metrics_and_measurements, nutrition).
#   4. Create an OAuth client (Web application). Authorized redirect URIs:
#        https://<your-deployment>/fitbit/callback
#        http://localhost:5173/fitbit/callback   (for local dev)
#   5. Copy the Client ID + Client Secret below.
#
# Client-side: exposes the client ID to the browser to build the consent URL.
VITE_GOOGLE_CLIENT_ID=
# Server-side (the /api/google-token function): the SAME client ID + the secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
